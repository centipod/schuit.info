[Unit]
Description=SCHUIT private GEDCOM verification and confirmed import queue
After=docker.service network-online.target
[Service]
Type=oneshot
User=www-data
Group=www-data
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/srv/schuit/gedcom-jobs /run/lock/schuit-worker.lock
ExecStart=/usr/bin/python3 /opt/infra/schuit/gedcom-worker.py
TimeoutStartSec=3600
MemoryMax=2G
CPUQuota=100%
